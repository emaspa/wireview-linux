<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WireView2.ViewModels"
             xmlns:controls="using:WireView2.Controls"
             x:Class="WireView2.Views.MonitoringView"
             x:DataType="vm:MonitoringViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="16,8">
            <TextBlock Text="Window (s):" VerticalAlignment="Center"/>
            <NumericUpDown Value="{Binding XWindowSeconds}" Minimum="1" Maximum="3600" Width="100"/>
            <TextBlock Text="Interval (ms):" VerticalAlignment="Center"/>
            <NumericUpDown Value="{Binding UpdateIntervalMs}" Minimum="50" Maximum="5000" Increment="50" Width="100"/>
            <Button Content="{Binding ExportCsvButtonText}" Click="OnExportCsvClicked"/>
        </StackPanel>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}" Margin="16,0,16,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MonitoringViewModel+TelemetryItem">
                    <CheckBox IsChecked="{Binding IsEnabled}" Margin="0,0,10,0" FontSize="12">
                        <TextBlock Text="{Binding Label}" Foreground="{Binding ColorBrush}"/>
                    </CheckBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <controls:SimpleLineChart Grid.Row="2" Margin="8"
                                  Chart="{Binding Chart}"
                                  SeriesColors="{Binding SeriesColorMap}"/>
    </Grid>
</UserControl>
