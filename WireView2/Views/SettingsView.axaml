<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WireView2.ViewModels"
             x:Class="WireView2.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="16">
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"/>
            <Border Background="{DynamicResource OverlayPanelBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="16"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Theme:" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding ThemeModes}"
                                  SelectedItem="{Binding ThemePreference}" Width="150"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Background:" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding BackgroundColorModes}"
                                  SelectedItem="{Binding BackgroundColorPreference}" Width="150"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Background Opacity:" VerticalAlignment="Center"/>
                        <Slider Value="{Binding BackgroundOpacity}" Minimum="0" Maximum="1"
                                Width="200" TickFrequency="0.1"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource OverlayPanelBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Startup" FontWeight="SemiBold" FontSize="16"/>
                    <CheckBox Content="Auto-start on login" IsChecked="{Binding AutoStart}"/>
                    <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Screen after connection:" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding DeviceScreens}"
                                  SelectedItem="{Binding ScreenAfterConnection}" Width="150"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource OverlayPanelBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Safety" FontWeight="SemiBold" FontSize="16"/>
                    <CheckBox Content="Shut down computer on device fault" IsChecked="{Binding SoftwareShutdownOnFault}"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                               Text="When enabled, the system will shut down when the device reports a fault alarm. This is an alternative to the hardware shutdown header for eGPU or other setups where the cable cannot be connected."/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource OverlayPanelBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Tray icon" FontWeight="SemiBold" FontSize="16"/>
                    <CheckBox Content="Show total power as a second tray icon" IsChecked="{Binding ShowTrayPower}"/>
                    <CheckBox Content="Show the unit name under the number" IsChecked="{Binding ShowTrayPowerUnit}"
                              IsEnabled="{Binding ShowTrayPower}" Margin="16,0,0,0"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                               Text="Adds a second tray icon next to the app icon showing the live total power (e.g. 180W), or a red icon when the device is disconnected. Right-click it for a dropdown of all live sensor values (per-pin voltage, current and power, temperatures and cable rating). This icon can also be toggled from the app icon's right-click menu. On GNOME, a tray / AppIndicator extension is required to see tray icons."/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource OverlayPanelBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Remote hosts (LAN)" FontWeight="SemiBold" FontSize="16"/>
                    <TextBox Text="{Binding RemoteHostsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Watermark="192.168.1.50:9876, 192.168.1.51"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                               Text="Comma-separated list of WireView hosts to read over the network (host or host:port; port defaults to 9876). Each host's devices appear in the device picker as 'lan @ host'. Changes apply within a few seconds. Leave empty to disable remote reading."/>
                    <TextBlock Text="Network secret (writes)" FontWeight="SemiBold" FontSize="16" Margin="0,12,0,0"/>
                    <TextBox Text="{Binding NetworkSecretText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             PasswordChar="●" Watermark="shared passphrase"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                               Text="Shared passphrase that authenticates writing settings to (and from) remote hosts via signed requests. Set the SAME value on every host. Leave empty to disable remote writes. Stored in plaintext in settings.json."/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource OverlayPanelBrush}" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="About" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="{Binding AppTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding BuildDateText}" Opacity="0.6"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Opacity="0.8">
                        <TextBlock Text="{Binding PortByText}"/>
                        <TextBlock Text="emaspa" FontWeight="SemiBold"/>
                        <TextBlock Text="-"/>
                        <TextBlock Text="https://github.com/emaspa/wireview-linux"
                                   Foreground="{DynamicResource SystemAccentColor}"
                                   TextDecorations="Underline"
                                   Cursor="Hand"
                                   PointerPressed="OnRepoLinkPressed"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" Text="{Binding Disclaimer}"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.6"
                               Text="Use at your own risk. This software interacts with hardware, while every effort has been made to ensure correctness, the authors are not responsible for any damage to your device."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
