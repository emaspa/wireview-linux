<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WireView2.ViewModels"
             xmlns:controls="using:WireView2.Controls"
             x:Class="WireView2.Views.LoggingView"
             x:DataType="vm:LoggingViewModel">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Device Logging" FontSize="24" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Read Log" Command="{Binding ReadCommand}"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsReading}"/>
                <Button Content="Export CSV…" Click="OnExportCsvClicked"/>
                <Button Content="Save Log…" Click="OnSaveLogClicked"/>
                <Button Content="Load Log…" Click="OnLoadLogClicked"/>
                <Button Content="Clear" Command="{Binding ClearCommand}"/>
                <TextBlock Text="Power cycle:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <ComboBox MinWidth="220"
                          ItemsSource="{Binding MeasurementCycles}"
                          SelectedItem="{Binding SelectedMeasurementCycle}"
                          IsEnabled="{Binding HasMeasurementCycles}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LoggingViewModel+MeasurementCycleItem">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Margin="0,4"/>
        </StackPanel>
        <ProgressBar Grid.Row="1" Minimum="0" Maximum="1" Value="{Binding ReadProgress}"
                     IsVisible="{Binding IsReading}" Height="14" Margin="0,4"/>
        <TextBlock Grid.Row="2" Opacity="0.6" FontSize="12" IsVisible="{Binding IsReading}"
                   Text="Reading the full on-device log (8 MB over USB serial) takes a few minutes. Live hwmon values pause during the transfer and resume automatically."
                   TextWrapping="Wrap"/>
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Items}" Margin="0,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MonitoringViewModel+TelemetryItem">
                    <CheckBox IsChecked="{Binding IsEnabled}" Margin="0,0,10,0" FontSize="12">
                        <TextBlock Text="{Binding Label}" Foreground="{Binding ColorBrush}"/>
                    </CheckBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <controls:SimpleLineChart Grid.Row="4" Margin="0,8,0,0"
                                  Chart="{Binding Chart}"
                                  SeriesColors="{Binding SeriesColorMap}"/>
    </Grid>
</UserControl>
