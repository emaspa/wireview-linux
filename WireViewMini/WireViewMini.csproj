<Project Sdk="Microsoft.NET.Sdk">
  <!-- wireview-mini: the headless always-on process (docs/footprint-plan.md
       section 4.2). Owns the device, publishes it on the LAN (loopback only while
       LAN publishing is off), raises fault alerts and optionally shuts the PC down
       on a fault. References only the two Avalonia-free libraries, never Avalonia.

       Two targets: net8.0 (Linux, macOS) and net8.0-windows10.0.17763.0 (Windows:
       a windowless WinExe so the logon start shows no console; CLI flags attach
       to the parent console). A -r/RuntimeIdentifier
       picks the matching one, so `dotnet publish -r linux-x64` and
       `dotnet publish -r win-x64` need no -f. -->
  <!-- No runtime identifier (solution build): both targets. With one, only the
       matching target, as a single TargetFramework (publish refuses a
       TargetFrameworks list, even a one-item list, without -f). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <TargetFrameworks>net8.0;net8.0-windows10.0.17763.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <TargetFramework Condition="$(RuntimeIdentifier.StartsWith('win'))">net8.0-windows10.0.17763.0</TargetFramework>
    <TargetFramework Condition="!$(RuntimeIdentifier.StartsWith('win'))">net8.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Lets the Windows target build (and restore its targeting pack) on Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <OutputType Condition="$(TargetFramework.Contains('-windows'))">WinExe</OutputType>
    <AssemblyName>wireview-mini</AssemblyName>
    <RootNamespace>WireView2.Mini</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <!-- Footprint, as in WireView2.csproj. System.GC.ConserveMemory is the
         RuntimeHostConfigurationOption below (no MSBuild property). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <AssemblyTitle>WireView Mini</AssemblyTitle>
    <Version>1.3.2.0</Version>
  </PropertyGroup>

  <!-- Publish. Linux (and macOS): NativeAOT by default, one native executable
       with no .NET runtime (plus libSystem.IO.Ports.Native.so for the serial
       port), much smaller in memory than the JIT build. It needs clang or gcc
       and zlib (zlib1g-dev, zlib-devel) and cannot cross-compile to another OS.
       Windows: NativeAOT too when publishing on a Windows machine (it needs the
       Visual Studio Build Tools with the C++ workload); from Linux, where the
       Windows build cannot be compiled natively, the JIT build.
       -p:PublishAot=false is the fallback everywhere: the self-contained
       single-file JIT build (bigger, heavier in memory, same behavior), for a
       machine without the native toolchain. -->
  <PropertyGroup>
    <PublishAot Condition="'$(PublishAot)' == '' and (!$(TargetFramework.Contains('-windows')) or $([MSBuild]::IsOSPlatform('Windows')))">true</PublishAot>
    <!-- The trim and AOT analyzers on every build of both targets: every JSON
         call goes through source-generated contexts (MiniJsonContext,
         WireViewJsonContext), so a reflection call shows up as a warning. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- One warning per call site, not one per assembly. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' != 'true' and '$(RuntimeIdentifier)' != ''">
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">true</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <!-- Tray icon (TrayIcon.cs). Linux: StatusNotifierItem plus com.canonical.dbusmenu
       over the session bus, written against the low-level D-Bus protocol library
       (no code generation, no UI framework). Windows: Shell_NotifyIcon through
       P/Invoke, no package. -->
  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <!-- The GUI's icon: the tray image on both platforms (Windows uses an entry of
       the .ico as is, Linux converts the 32-bit entries to SNI pixmaps), and the
       Windows executable's icon. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <ApplicationIcon>..\WireView2\Assets\Icons\bear.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\WireView2\Assets\Icons\bear.ico" LogicalName="wireview-mini.ico" />
    <!-- The control panel page (ControlPanel.cs): one file, inline CSS and JS. -->
    <EmbeddedResource Include="ControlPanel.html" LogicalName="wireview-mini.ControlPanel.html" />
    <!-- The fan templates the app tints with the highlight colour for a custom
         background's fan frames (the page does the raster work in the browser). -->
    <EmbeddedResource Include="..\WireView2\Assets\DeviceAssets\fan1.png" LogicalName="wireview-mini.fan1.png" />
    <EmbeddedResource Include="..\WireView2\Assets\DeviceAssets\fan2.png" LogicalName="wireview-mini.fan2.png" />
  </ItemGroup>

  <!-- The bundled device firmware, the GUI's own file (not a copy in this
       project): next to the executable, where FirmwareService and the GUI look
       for it (BundledFirmware.GetPath). Without it the panel's Firmware section
       says the image is missing and nothing else changes. -->
  <ItemGroup>
    <None Include="..\WireView2\Firmware\TG-WV-PRO2-FW.hex" Link="Firmware\TG-WV-PRO2-FW.hex"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" TargetPath="TG-WV-PRO2-FW.hex" />
    <!-- The factory theme artwork (the app's file, 403 KB): read only when the
         panel's Restore factory artwork is used (ThemeService). Also the Noctua
         Edition's factory artwork. -->
    <None Include="..\WireView2\Firmware\ext_flash.bin" Link="Firmware\ext_flash.bin"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" TargetPath="ext_flash.bin" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WireViewDeviceLib\WireViewDeviceLib\WireViewDeviceLib.csproj" />
    <ProjectReference Include="..\WireViewNet\WireViewNet.csproj" />
  </ItemGroup>
</Project>
